{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "typeRoots": ["../app/node_modules/@types", "../app/node_modules"],
    "paths": { "@app/*": ["../app/src/*"], "vite/client": ["../app/node_modules/vite/client.d.ts"] }
  },
  "include": ["src"]
}
