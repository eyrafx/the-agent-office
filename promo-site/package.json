{
  "name": "agentoffice-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AgentOffice tanıtım sayfası: uygulamanın gerçek ada kodu, sahte (örnek) verilerle tarayıcıda çalışır.",
  "scripts": {
    "dev": "node ../app/node_modules/vite/bin/vite.js --config vite.config.mjs --host 127.0.0.1 --port 5180 --strictPort",
    "build": "node ../app/node_modules/vite/bin/vite.js build --config vite.config.mjs",
    "preview": "node ../app/node_modules/vite/bin/vite.js preview --config vite.config.mjs --host 127.0.0.1 --port 5181 --strictPort",
    "typecheck": "node ../app/node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node scripts/check.mjs"
  }
}
